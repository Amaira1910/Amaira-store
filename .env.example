# ---------------------------------------------------------------------------
# Amaira Store — environment configuration
# Copy to .env.local for local dev; set the same keys in your host's dashboard.
# NEVER commit real keys. .env.local is git-ignored.
# ---------------------------------------------------------------------------

# Public site URL (used for canonical URLs, sitemap, OG tags, Razorpay callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Razorpay -------------------------------------------------------------
# Get these from https://dashboard.razorpay.com → Settings → API Keys.
# Test keys start with rzp_test_, live keys with rzp_live_.
# The KEY_ID is sent to the browser (that is by design and safe).
# The KEY_SECRET and WEBHOOK_SECRET must stay server-side only.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay → Settings → Webhooks. Point the webhook at:
#   https://<your-domain>/api/razorpay/webhook
# Subscribe to: payment.captured, payment.failed, order.paid, refund.processed
RAZORPAY_WEBHOOK_SECRET=

# --- Store details --------------------------------------------------------
# Shown on invoices and the contact page.
NEXT_PUBLIC_STORE_PHONE=+919900330022
NEXT_PUBLIC_STORE_EMAIL=care@amairastore.in
STORE_GSTIN=

# --- Database -------------------------------------------------------------
# SQLite file. Defaults to ./data-store/amaira.db. Must be on a PERSISTENT
# disk — a Railway/Fly volume, or a VPS path. Not Vercel's ephemeral fs.
DATABASE_PATH=./data-store/amaira.db

# --- First admin user -----------------------------------------------------
# Read once, on a database with no users, to create the owner account.
# Delete these after first boot; change the password from inside the portal.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Owner

# Opening stock given to every new SKU when the catalog is first seeded.
# Leave at 0 in production and receive stock through the admin portal so it
# lands in the movement ledger.
SEED_OPENING_STOCK=0

# --- Email ----------------------------------------------------------------
# Order confirmations and enquiry alerts. Without these the shop still works:
# messages are logged and recorded as 'skipped', and every order and enquiry
# is still visible in /admin — they just are not pushed to an inbox.
#
# Resend is the simplest to set up (resend.com). Verify your sending domain
# first, or delivery will land in spam.
RESEND_API_KEY=
# Must be on a domain you have verified with the provider.
EMAIL_FROM=Amaira <orders@amairastore.in>
# Where enquiry alerts go. Defaults to the store email in data/store.ts.
ENQUIRY_INBOX=
